  "lessons": [
    {
      "lesson_key": "A1-GR-01",
      "title": "A1.1 — Согласование: прилагательные и местоимения",
      "lesson_type": "grammar",
      "display_order": 100,
      "is_active": true,
      "audio_url": null,
      "skill_codes": [
        "NOM-01",
        "NOM-02"
      ],
      "content": {
        "objective_vi": "Hòa hợp tính từ, đại từ sở hữu và đại từ chỉ định với danh từ theo giống và số.",
        "theory": [
          "Tính từ đổi theo giống/số: новый стол, новая книга, новое окно, новые книги.",
          "мой/моя/моё/мои và этот/эта/это/эти phải phù hợp với danh từ."
        ],
        "examples": [
          {
            "ru": "Это новая книга.",
            "vi": "Đây là một quyển sách mới."
          },
          {
            "ru": "Мои друзья живут в Москве.",
            "vi": "Bạn của tôi sống ở Moskva."
          }
        ],
        "practice": [
          {
            "id": "A1-GR-01-P1",
            "type": "single_choice",
            "prompt": "Выберите: Это ___ книга.",
            "options": [
              {
                "key": "A",
                "text": "новый"
              },
              {
                "key": "B",
                "text": "новая"
              },
              {
                "key": "C",
                "text": "новое"
              }
            ],
            "correct_option_key": "B",
            "feedback_vi": "книга là giống cái nên dùng новая."
          }
        ]
      }
    },
    {
