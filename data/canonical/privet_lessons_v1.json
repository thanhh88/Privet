                "text": "работают"
              },
              {
                "key": "C",
                "text": "работаю"
              }
            ],
            "correct_option_key": "B",
            "feedback_vi": "Они là ngôi 3 số nhiều nên dùng работают."
          }
        ]
      }
    },
